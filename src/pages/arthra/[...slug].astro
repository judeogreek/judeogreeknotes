---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byName } from '../../categories';
import { getAuthor } from '../../authors';
import { fmtDate, catLabel } from '../../lang';
export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const c = byName(d.category);
const cat = c ? catLabel(c, d.lang) : d.category;
const author = await getAuthor(d.author);
const hasBio = !!(author && author.entry && author.entry.body.trim().length > 0);
const Bio = hasBio ? (await author.entry.render()).Content : null;
---
<Base title={d.title} description={d.summary} image={d.image}>
  <article lang={d.lang}>
    <h1>{d.title}</h1>
    <p class="muted small">{cat} · {fmtDate(d.date, d.lang)}{author && <> · {author.name}</>}</p>
    {d.image && (
      <figure class="hero">
        <img src={d.image} alt={d.imageAlt ?? ''} />
        {d.imageCredit && <figcaption class="muted small">{d.imageLink ? <a href={d.imageLink}>{d.imageCredit}</a> : d.imageCredit}</figcaption>}
      </figure>
    )}
    <Content />
  </article>
  {hasBio && (
    <aside class="bio">
      <p class="small muted">Συγγραφέας <span class="en">Author</span></p>
      <p class="bio-name">{author.name}</p>
      <Bio />
    </aside>
  )}
</Base>
