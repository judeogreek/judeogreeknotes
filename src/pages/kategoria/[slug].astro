---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getCollection } from 'astro:content';
import { categories, byName } from '../../categories';
export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getCollection('articles', ({ data }) => byName(data.category)?.slug === cat.slug)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={cat.el}>
  <h1>{cat.el}</h1>
  <ArticleList posts={posts} />
</Base>
