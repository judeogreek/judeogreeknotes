---
import { getCollection } from 'astro:content';
import { categories } from '../categories';
const { title, description = 'Σύντομα κείμενα και βιβλιοκριτικές για την ιστορία των Εβραίων της Ελλάδας.', image } = Astro.props;
const full = title ? `${title} · Judeo-Greek Notes` : 'Judeo-Greek Notes';
const og = image ? new URL(image, Astro.site).href : null;
const here = Astro.url.pathname;
const cur = (h) => (here.startsWith(h) ? 'on' : undefined);
const all = await getCollection('articles');
const langs = ['el', 'en', 'fr'].filter((l) => all.some((p) => p.data.lang === l));
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {og && <meta property="og:image" content={og} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="wide">
    <div class="mast">
      {langs.length > 1 && <div class="langs">{langs.map((l) => <a href={`/glossa/${l}/`}>{l.toUpperCase()}</a>)}</div>}
      <a class="brand" href="/">Judeo-Greek Notes</a>
    </div>
  </header>
  <div class="wide layout">
    <nav class="side" aria-label="Κύριο μενού">
      <p class="lbl">Κατηγορίες</p>
      {categories.map((c) => <a class={cur(`/kategoria/${c.slug}/`)} href={`/kategoria/${c.slug}/`}>{c.el}</a>)}
      <hr />
      <a class={cur('/piges/')} href="/piges/">Πηγές</a>
      <a class={cur('/sxetika/')} href="/sxetika/">Σχετικά</a>
      <a class={cur('/contact/')} href="/contact/">Επικοινωνία</a>
    </nav>
    <details class="mobile-menu">
      <summary>☰ Μενού</summary>
      <nav class="mnav" aria-label="Μενού">
        {categories.map((c) => <a class={cur(`/kategoria/${c.slug}/`)} href={`/kategoria/${c.slug}/`}>{c.el}</a>)}
        <a class={cur('/piges/')} href="/piges/">Πηγές</a>
        <a class={cur('/sxetika/')} href="/sxetika/">Σχετικά</a>
        <a class={cur('/contact/')} href="/contact/">Επικοινωνία</a>
      </nav>
    </details>
    <main><slot /></main>
  </div>
  <footer class="wide muted small">© {new Date().getFullYear()} Judeo-Greek Notes</footer>
</body>
</html>
<style is:global>
  :root { --paper:#F5F6F8; --ink:#17212B; --muted:#566270; --rule:#CDD5DD; --navy:#16324F; --blue:#1D4E7A; --tint:#E6ECF2; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:'Source Serif 4',Georgia,serif; font-size:1.125rem; line-height:1.7; }
  .wrap { max-width:44rem; margin:0 auto; padding:0 1.25rem; }
  a { color:var(--blue); } a:focus-visible { outline:2px solid var(--blue); outline-offset:3px; }
  .muted { color:var(--muted); } .small { font-size:.9rem; line-height:1.5; }
  .en { color:var(--muted); font-size:.85em; }
  .mast { margin-top:1.1rem; padding:1.2rem 0 1.1rem; border-top:1px solid var(--navy); border-bottom:3px double var(--navy); text-align:center; }
  .langs { text-align:right; font-size:.85rem; letter-spacing:.06em; margin-bottom:.8rem; }
  .langs a { color:var(--muted); text-decoration:none; margin-left:.9rem; } .langs a:hover { color:var(--blue); text-decoration:underline; }
  .brand { display:inline-block; font-family:'EB Garamond',Georgia,serif; font-weight:700; font-size:clamp(1.05rem,5vw,2rem); line-height:1.2; letter-spacing:.28em; padding-left:.28em; text-transform:uppercase; color:var(--navy); text-decoration:none; }
  .wide { max-width:60rem; margin:0 auto; padding:0 1.25rem; }
  .layout { display:grid; grid-template-columns:11.5rem minmax(0,1fr); gap:0 3rem; padding-top:4rem; }
  .layout main { max-width:44rem; }
  .side { position:sticky; top:1.5rem; align-self:start; display:flex; flex-direction:column; gap:.45rem; font-size:1rem; line-height:1.4; }
  .side .lbl { margin:0 0 .3rem; font-size:.8rem; letter-spacing:.06em; color:var(--muted); }
  .side hr { width:100%; margin:.8rem 0; border:0; border-top:1px solid var(--rule); }
  .side a, .mnav a { color:var(--ink); text-decoration:none; padding:.15rem 0; }
  .side a:hover, .mnav a:hover { color:var(--blue); text-decoration:underline; }
  .side a.on, .mnav a.on { color:var(--navy); font-weight:600; }
  .mobile-menu { display:none; margin-bottom:2rem; }
  .mobile-menu summary { display:inline-block; cursor:pointer; list-style:none; padding:.3rem 1rem; border:1px solid var(--navy); border-radius:2px; color:var(--navy); font-size:.95rem; line-height:1.5; }
  .mobile-menu summary::-webkit-details-marker { display:none; }
  .mobile-menu summary:focus-visible { outline:2px solid var(--blue); outline-offset:3px; }
  .mobile-menu[open] summary { background:var(--navy); color:var(--paper); }
  .mnav { display:flex; flex-direction:column; gap:.5rem; margin-top:1rem; padding:1rem 0; border-top:1px solid var(--rule); border-bottom:1px solid var(--rule); }
  @media (max-width:52rem) { .layout { grid-template-columns:minmax(0,1fr); padding-top:2.5rem; } .side { display:none; } .mobile-menu { display:block; } }
  h1,h2,h3 { font-family:'EB Garamond',Georgia,serif; font-weight:500; line-height:1.2; color:var(--navy); }
  h1 { font-size:2.5rem; margin:0 0 .5rem; } h2 { font-size:1.7rem; margin:2.2rem 0 .5rem; }
  h2.more { font-size:1.3rem; margin:2.5rem 0 .2rem; }
  .featured { display:grid; grid-template-columns:1fr; gap:1.25rem; background:var(--tint); padding:1.6rem; border-radius:2px; }
  .featured:has(.fimg) { grid-template-columns:8rem 1fr; }
  .fimg { width:100%; height:auto; display:block; }
  .featured p { margin:.4rem 0 0; } .featured .kicker { margin:0 0 .3rem; font-size:.85rem; color:var(--muted); }
  .ftitle { display:block; font-family:'EB Garamond',Georgia,serif; font-size:2rem; line-height:1.2; color:var(--navy); text-decoration:none; }
  .ftitle:hover { text-decoration:underline; }
  .list { list-style:none; margin:0; padding:0; }
  .list li { display:grid; grid-template-columns:9.5rem 1fr; gap:1rem; padding:1.1rem 0; border-bottom:1px solid var(--rule); }
  .list time { font-size:.95rem; padding-top:.35rem; }
  .title { font-family:'EB Garamond',Georgia,serif; font-size:1.55rem; line-height:1.25; color:var(--ink); text-decoration:none; }
  .title:hover { color:var(--blue); } .summary { margin:.4rem 0 0; }
  .thumb-s { float:right; width:4.5rem; height:auto; margin:.2rem 0 .5rem 1rem; }
  .tag { margin-left:.6rem; padding:0 .35rem; border:1px solid var(--rule); border-radius:3px; font-size:.75rem; letter-spacing:.04em; }
  article { max-width:40rem; } article p { margin:0 0 1.2rem; }
  .src { list-style:none; margin:1.5rem 0 0; padding:0; } .src li { padding:1rem 0; border-bottom:1px solid var(--rule); }
  .src li > a { font-family:'EB Garamond',Georgia,serif; font-size:1.5rem; } .src p { margin:.3rem 0 0; }
  .hero { margin:1.2rem 0 1.6rem; } .hero img { display:block; max-width:100%; max-height:28rem; width:auto; height:auto; } .hero figcaption { margin-top:.4rem; }
  .bio { max-width:40rem; margin-top:3rem; padding:1.3rem 1.5rem; background:var(--tint); border-radius:2px; }
  .bio p { margin:0 0 .6rem; } .bio .bio-name { font-family:'EB Garamond',Georgia,serif; font-size:1.4rem; line-height:1.2; color:var(--navy); }
  footer { margin-top:4rem; padding-top:1.25rem; padding-bottom:2.5rem; border-top:1px solid var(--rule); }
  @media (max-width:36rem) { .brand { letter-spacing:.2em; padding-left:.2em; } .list li { grid-template-columns:1fr; gap:.2rem; } h1 { font-size:2rem; } .ftitle { font-size:1.6rem; } .featured { padding:1.2rem; } .featured:has(.fimg) { grid-template-columns:1fr; } .fimg { max-width:9rem; } }
</style>
