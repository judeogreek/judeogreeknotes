---
const { posts } = Astro.props;
const fmt = (d) => d.toLocaleDateString('el-GR', { year: 'numeric', month: 'long', day: 'numeric' });
---
{posts.length === 0 ? <p class="muted">Δεν υπάρχουν ακόμα άρθρα σε αυτή την κατηγορία.</p> : (
<ul class="list">
  {posts.map((p) => (
    <li>
      <time class="muted" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
      <div>
        <a class="title" href={`/arthra/${p.slug}/`}>{p.data.title}</a>
        <div class="muted small">{p.data.category}</div>
        {p.data.summary && <p class="summary">{p.data.summary}</p>}
      </div>
    </li>
  ))}
</ul>
)}
